{
  "name": "rove-mobile",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "typecheck": "turbo run typecheck && tsc -p tsconfig.e2e.json",
    "test": "turbo run test",
    "dev:api": "pnpm --filter @rove/api dev",
    "docs:check": "markdownlint-cli2 'docs/**/*.md' '*.md'",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,yaml,yml}\"",
    "boundaries:check": "node scripts/boundaries.mjs",
    "tooling:test": "node --test scripts/*.test.mjs",
    "security:audit": "pnpm audit --audit-level=moderate",
    "build:mobile": "pnpm --filter @rove/rider build && pnpm --filter @rove/driver build",
    "test:e2e": "playwright test",
    "db:staging:migrate": "node --env-file=.env.neon.staging --import tsx packages/database/src/staging-migrate.ts",
    "db:staging:role": "node --env-file=.env.neon.staging --import tsx packages/database/src/staging-role.ts",
    "db:staging:smoke": "node --env-file=.env.neon.staging --import tsx apps/api/src/staging-smoke.ts",
    "staging:preflight": "node --import tsx apps/api/src/staging-preflight-cli.ts",
    "db:staging:check": "node --import tsx packages/database/src/staging-readiness-cli.ts",
    "auth:staging:check": "node scripts/auth0-staging-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
