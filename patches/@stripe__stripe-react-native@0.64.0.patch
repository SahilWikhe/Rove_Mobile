 @_spi(PrivateBetaCustomerSheet) @_spi(CustomerSessionBetaAccess) @_spi(STP) import StripePaymentSheet
+// Coalesce overlapping requests from CustomerSheet. The JS bridge carries no
+// request identifier, so only one event may be outstanding for each provider.
+final class CustomerSheetPendingCallbacks<Value> {
+    private let lock = NSLock()
+    private var callbacks: [(Result<Value, Error>) -> Void] = []
+
+    func append(_ callback: @escaping (Result<Value, Error>) -> Void) -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        let shouldRequest = callbacks.isEmpty
+        callbacks.append(callback)
+        return shouldRequest
+    }
+
+    func resolve(_ value: Value) { finish(.success(value)) }
+
+    func cancel() { finish(.failure(CancellationError())) }
+
+    private func finish(_ result: Result<Value, Error>) {
+        lock.lock()
+        let pending = callbacks
+        callbacks.removeAll()
+        lock.unlock()
+        // Resume outside the lock; resumed tasks may request another refresh.
+        for callback in pending { callback(result) }
+    }
+}
