{
  "expo": {
    "name": "Rove Driver",
    "slug": "rove-driver",
    "version": "1.0.0",
    "scheme": "rove-driver",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.roveride.driver"
    },
    "android": {
      "package": "co.roveride.driver"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rove uses your precise location while online to find nearby ride requests and guide your active trip.",
          "locationAlwaysAndWhenInUsePermission": "Rove shares your location while you are online or on a trip, including when using navigation or locking your phone. Go offline to stop.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "186d7355-1efa-4968-8fe9-93c43a7ecbf2"
      }
    },
    "owner": "roveride.co"
  }
}
