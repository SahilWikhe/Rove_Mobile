# Deployment settings, validated by src/config.ts. Never copy real values into this file.
# The local synthetic server does not consume these settings.
ROVE_ENVIRONMENT=staging
DATABASE_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
GOOGLE_MAPS_API_KEY=
ALLOWED_ORIGINS_JSON=[]
# Supply approved integer-cent rates and a launch service-area rectangle. No production defaults.
RATE_POLICY_JSON=
SERVICE_AREA_JSON=
# Production requires this to equal RATE_POLICY_JSON.version after business review.
RATE_POLICY_APPROVED_VERSION=

# Test credentials in staging/preview. Live credentials only with ROVE_ENVIRONMENT=production.
STRIPE_ACCOUNT_ID=
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHOD_CONFIGURATION=
# Enable only after migration 0031 and compatible receipt clients; reads refund facts, never issues refunds.
PAYMENT_REFUNDS_ENABLED=false

# Random 32-128 character base64url secret, unique per environment.
CRON_SECRET=

# Hosted Connect onboarding is off until the separate recipient-account model is reviewed.
STRIPE_CONNECT_ONBOARDING_ENABLED=false
# HTTPS origin serving this API's /connect/return and /connect/refresh pages.
STRIPE_CONNECT_RETURN_ORIGIN=
# Live-only acknowledgement, after business review: recipient-express-platform-responsibility
STRIPE_CONNECT_MODEL_APPROVED=

# Separate thin-event destination signing secret; never reuse the payment webhook secret.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Optional paired EAS project UUIDs; omit both until native push registration is configured.
# Use different app projects, and isolate staging/production databases and native builds.
# EXPO_RIDER_PROJECT_ID=
# EXPO_DRIVER_PROJECT_ID=

# Delivery remains off until native credentials and sandbox delivery are verified.
EXPO_PUSH_DELIVERY_ENABLED=false
# Server-only Expo access token; enable enhanced push security in both EAS projects.
# EXPO_PUSH_ACCESS_TOKEN=

# Private document intake. Keep disabled until the AWS bucket and backend identity are configured.
# Use separate buckets per environment. These values are server-only; never EXPO_PUBLIC_.
DOCUMENT_UPLOADS_ENABLED=false
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_REGION=
DOCUMENT_S3_OWNER_ACCOUNT_ID=
# Required on Vercel when uploads or scanning are enabled. Local CLI profiles can leave blank.
# Use a scoped role trusted by this Vercel project/environment; never put AWS access keys in mobile env.
DOCUMENT_AWS_ROLE_ARN=
# AWS SDK uses the backend's standard credential provider. Do not commit AWS credentials.

# Optional GuardDuty result polling. Deploy infra/aws/driver-documents.template.json
# with EnableMalwareScanning=true only after reviewing AWS usage costs.
# Attach DocumentScanReaderPolicyArn to the worker identity; set the trusted role
# from DocumentScannerRoleArn. Verify the plan is ACTIVE and synthetic scan
# results work before enabling this switch. Never use a mobile/public env prefix.
# Scanning may stay enabled while DOCUMENT_UPLOADS_ENABLED=false.
DOCUMENT_SCANNING_ENABLED=false
DOCUMENT_GUARDDUTY_ROLE_ARN=

# Optional server-only Auth0 verification resend. Omit both until configured.
# AUTH0_VERIFICATION_CLIENT_ID=
# AUTH0_VERIFICATION_CLIENT_SECRET=

# Enables real refund mutations. Requires migration 0032, refund tracking, staff MFA/permission and approved policy.
PAYMENT_REFUND_OPERATIONS_ENABLED=false

# Verified processor refund balance journals; requires migration 0033 and refund tracking.
PAYMENT_REFUND_ACCOUNTING_ENABLED=false

# Dispute observations, staff review, refund hold and balance journals; requires migration 0034.
PAYMENT_DISPUTES_ENABLED=false
