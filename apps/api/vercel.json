{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "outputDirectory": "public",
  "regions": ["iad1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 120
    },
    "api/worker.ts": {
      "maxDuration": 120,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "rove-worker-wake"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/health/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/tracking/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/webhooks/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/internal/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/connect/:path*",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/internal/recover",
      "schedule": "* * * * *"
    }
  ]
}
