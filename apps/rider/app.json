{
  "expo": {
    "name": "Rove",
    "slug": "rove-rider",
    "version": "1.0.0",
    "scheme": "rove-rider",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.roveride.rider"
    },
    "android": {
      "package": "co.roveride.rider"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74f40b2f-bcb5-4e80-9760-bd0903c67bf7"
      }
    },
    "owner": "roveride.co"
  }
}
