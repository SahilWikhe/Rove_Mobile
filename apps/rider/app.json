{
  "expo": {
    "name": "Rove",
    "slug": "rove-rider",
    "version": "1.0.0",
    "scheme": "rove-rider",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.roveride.rider"
    },
    "android": {
      "package": "co.roveride.rider"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-web-browser"],
    "web": {
      "bundler": "metro"
    }
  }
}
