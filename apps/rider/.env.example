# Public app configuration. Never place server secrets in EXPO_PUBLIC_* values.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_AUTH_ISSUER=
EXPO_PUBLIC_AUTH_CLIENT_ID=
EXPO_PUBLIC_AUTH_AUDIENCE=
# Stripe publishable key for the same sandbox/live account as the API.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Development-only synthetic API mode; ignored in release bundles.
EXPO_PUBLIC_SYNTHETIC=false

# Android Maps SDK key restricted to this app package and signing certificates. Rebuild the native app after setting it.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
# iOS Maps SDK key restricted to this app bundle identifier.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=

# Public EAS UUID for this app; must match its backend EXPO_RIDER_PROJECT_ID.
# EXPO_PUBLIC_EAS_PROJECT_ID=

# Android Firebase client config: local file path, or EAS secret file variable.
# Not an FCM service-account private key. Rebuild Android after configuring.
# GOOGLE_SERVICES_JSON=/absolute/path/to/google-services.json
